class PerplexityIndex:
def __init__(self, path=DB_FILE):
self.path = str(path)
self.local = threading.local()
self.lock = threading.RLock()
self._init()

def _conn(self):
if not hasattr(self.local, "conn"):
conn = sqlite3.connect(self.path, timeout=60,
check_same_thread=False, isolation_level=None)
conn.execute("PRAGMA journal_mode=WAL")
conn.execute("PRAGMA synchronous=NORMAL")
conn.execute("PRAGMA cache_size=-128000")
conn.execute("PRAGMA temp_store=MEMORY")
conn.execute("PRAGMA mmap_size=268435456")
self.local.conn = conn
return self.local.conn

def _init(self):
with self.lock:
conn = self._conn()
cur = conn.cursor()
cur.execute(
"CREATE TABLE IF NOT EXISTS sources ("
"id INTEGER PRIMARY KEY AUTOINCREMENT,"
"url TEXT UNIQUE,domain TEXT,title TEXT,snippet TEXT,"
"content TEXT,source TEXT,score INTEGER,simhash INTEGER,"
"added_at REAL)"
)
cur.execute("CREATE INDEX IF NOT EXISTS idx_url ON sources(url)")
cur.execute("CREATE INDEX IF NOT EXISTS idx_domain ON sources(domain)")
cur.execute("CREATE INDEX IF NOT EXISTS idx_sh ON sources(simhash)")
cur.execute(
"CREATE TABLE IF NOT EXISTS terms ("
"term TEXT,src_id INTEGER,freq INTEGER,"
"PRIMARY KEY (term, src_id))"
)
cur.execute("CREATE INDEX IF NOT EXISTS idx_term ON terms(term)")
cur.execute("CREATE INDEX IF NOT EXISTS idx_src ON terms(src_id)")
cur.execute(
"CREATE TABLE IF NOT EXISTS queue ("
"url TEXT PRIMARY KEY,priority INTEGER,added_at REAL,visited INTEGER DEFAULT 0)"
)
cur.execute("CREATE INDEX IF NOT EXISTS idx_q ON queue(visited, priority)")
cur.execute(
"CREATE TABLE IF NOT EXISTS stats (key TEXT PRIMARY KEY, value REAL)"
)
for k in ("total_sources", "total_terms", "total_queue"):
cur.execute("INSERT OR IGNORE INTO stats (key,value) VALUES (?,0)", (k,))
conn.commit()

def add_source(self, url, domain, title, snippet, content, source, score):
if not url:
return None
sh = simhash((title or "") + " " + (snippet or ""))
with self.lock:
conn = self._conn()
cur = conn.cursor()
try:
cur.execute(
"INSERT OR IGNORE INTO sources "
"(url,domain,title,snippet,content,source,score,simhash,added_at) "
"VALUES (?,?,?,?,?,?,?,?,?)",
(url, domain, (title or "")[:500], (snippet or "")[:1000],
(content or "")[:50000], source, score, sh, time.time())
)
if cur.rowcount == 0:
cur.execute("SELECT id FROM sources WHERE url = ?", (url,))
r = cur.fetchone()
return r[0] if r else None
sid = cur.lastrowid
words = tokenize((title or "") + " " + (content or "")[:20000])
freq = Counter(words)
if freq:
cur.executemany(
"INSERT OR REPLACE INTO terms (term,src_id,freq) VALUES (?,?,?)",
[(w, sid, n) for w, n in freq.items()]
)
return sid
except Exception as e:
log("add_source err " + str(e)[:100])
return None

def search(self, query, limit=50):
words = tokenize(query)
if not words:
return []
ph = ",".join("?" * len(words))
with self.lock:
conn = self._conn()
cur = conn.cursor()
cur.execute(
"SELECT src_id, SUM(freq) AS s FROM terms WHERE term IN (" +
ph + ") GROUP BY src_id ORDER BY s DESC LIMIT ?",
words + [limit]
)
ids = [r[0] for r in cur.fetchall()]
if not ids:
return []
ph2 = ",".join("?" * len(ids))
cur.execute(
"SELECT id,url,domain,title,snippet,source,score FROM sources "
"WHERE id IN (" + ph2 + ")",
ids
)
out = []
for r in cur.fetchall():
out.append({
"id": r[0], "url": r[1], "domain": r[2],
"title": r[3], "snippet": r[4],
"source": r[5], "score": r[6] or 50,
"score_final": (r[6] or 50) + 20,
})
return out

def stats(self):
with self.lock:
conn = self._conn()
cur = conn.cursor()
cur.execute("SELECT COUNT(*) FROM sources")
s = cur.fetchone()[0] or 0
cur.execute("SELECT COUNT(*) FROM terms")
t = cur.fetchone()[0] or 0
cur.execute("SELECT COUNT(*) FROM queue WHERE visited = 0")
q = cur.fetchone()[0] or 0
return {"sources": s, "terms": t, "queue": q}

def recent(self, limit=10):
with self.lock:
conn = self._conn()
cur = conn.cursor()
cur.execute(
"SELECT url,title,domain,added_at FROM sources "
"ORDER BY id DESC LIMIT ?", (limit,)
)
return [{"url": r[0], "title": r[1], "domain": r[2], "ts": r[3]}
for r in cur.fetchall()]

# ─── Queue ───
def queue_add(self, url, priority=5):
with self.lock:
conn = self._conn()
cur = conn.cursor()
try:
cur.execute(
"INSERT OR IGNORE INTO queue (url,priority,added_at,visited) "
"VALUES (?,?,?,0)", (url, priority, time.time()))
conn.commit()
return cur.rowcount > 0
except Exception:
return False

def queue_next(self, n=64):
with self.lock:
conn = self._conn()
cur = conn.cursor()
cur.execute(
"SELECT url FROM queue WHERE visited = 0 "
"ORDER BY priority ASC, added_at ASC LIMIT ?", (n,)
)
rows = [r[0] for r in cur.fetchall()]
if rows:
ph = ",".join("?" * len(rows))
cur.execute("UPDATE queue SET visited = 1 WHERE url IN (" + ph + ")", rows)
conn.commit()
return rows

def queue_size(self):
with self.lock:
conn = self._conn()
cur = conn.cursor()
cur.execute("SELECT COUNT(*) FROM queue WHERE visited = 0")
return cur.fetchone()[0] or 0


