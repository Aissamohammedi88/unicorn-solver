"score": 70,
})
elif name == "arxiv":
for e in re.findall(r"<entry>(.*?)</entry>", body, re.DOTALL)[:3]:
t = re.search(r"<title>(.*?)</title>", e, re.DOTALL)
s = re.search(r"<summary>(.*?)</summary>", e, re.DOTALL)
l = re.search(r"<id>(.*?)</id>", e, re.DOTALL)
if t and s:
out.append({
"title": t.group(1).strip()[:150],
"snippet": s.group(1).strip()[:300],
"url": l.group(1).strip() if l else "",
"source": "ArXiv",
"score": 80,
})
elif name == "crossref":
data = json.loads(body)
for item in data.get("message", {}).get("items", [])[:5]:
out.append({
"title": (item.get("title") or [""])[0][:200],
"snippet": (item.get("abstract") or "")[:300],
"url": item.get("URL", ""),
"source": "Crossref",
"score": 75,
})
elif name == "openalex":
data = json.loads(body)
for item in data.get("results", [])[:5]:
out.append({
"title": item.get("title", ""),
"snippet": "Citations {}".format(item.get("cited_by_count", 0)),
"url": item.get("doi", ""),
"source": "OpenAlex",
"score": 75,
