def search(query, limit=30):
if not query or not query.strip():
return {"query": query, "results": [], "count": 0, "sources": []}

ck = ("p1", query.lower(), limit)
with CACHE_LOCK:
if ck in CACHE:
ts, data = CACHE[ck]
if time.time() - ts < CACHE_TTL:
CACHE.move_to_end(ck)
cached = dict(data)
cached["cached"] = True
return cached

t0 = time.time()
log("SEARCH : " + query)

# 1) Index local
internal = IDX.search(query, limit=limit)

# 2) APIs de transit en parallèle
external = []
with ThreadPoolExecutor(max_workers=16) as ex:
futures = {}
for name, cfg in TRANSIT_APIS.items():
if cfg["auth"] and not all(os.environ.get(k) for k in cfg["auth"]):
continue
url = cfg["url"].replace("{q}", urllib.parse.quote(query))
futures[ex.submit(http_get, url, 8)] = name
for fut in as_completed(futures, timeout=15):
name = futures[fut]
try:
r = fut.result(timeout=10)
if not r.get("ok"):
continue
res = parse_transit(name, r["body"])
if res:
external.extend(res)
except Exception:
pass

# 3) Dédup + ranking
all_res = internal + external
seen = set()
ranked = []
words = set(re.findall(r"\w+", query.lower()))
for r in all_res:
url = (r.get("url") or "").strip()
if not url or url in seen:
continue
seen.add(url)
score = r.get("score", 50)
title_low = (r.get("title") or "").lower()
snippet_low = (r.get("snippet") or "").lower()
for w in words:
if w in title_low:
score += 8
if w in snippet_low:
score += 3
r["score_final"] = score
ranked.append(r)
ranked.sort(key=lambda x: -x["score_final"])

# 4) Async re-index
def _idx(results):
for r in results[:20]:
domain = urllib.parse.urlparse(r.get("url", "")).netloc
IDX.add_source(r.get("url"), domain, r.get("title"),
r.get("snippet"), "", r.get("source", "EXT"), r.get("score", 50))
threading.Thread(target=_idx, args=(external,), daemon=True).start()

# 5) Réponse type Perplexity
answer = generate_answer(query, ranked)

duration_ms = round((time.time() - t0) * 1000, 2)
result = {
"query": query,
"timestamp": datetime.datetime.now().isoformat(),
"count": len(ranked),
"sources": sorted(set(r.get("source", "") for r in ranked if r.get("source"))),
"duration_ms": duration_ms,
"internal_matches": len(internal),
"external_matches": len(external),
"cached": False,
"answer": answer,
"results": ranked[:limit],
}
with CACHE_LOCK:
CACHE[ck] = (time.time(), result)
while len(CACHE) > CACHE_MAX:
CACHE.popitem(last=False)
log("DONE {} results in {}ms".format(len(ranked), duration_ms))
return result


def parse_transit(name, body):
"""Parse une réponse d'API de transit."""
out = []
try:
if name == "duckduckgo_ia":
data = json.loads(body)
if data.get("AbstractText"):
out.append({
"title": data.get("Heading", ""),
"snippet": data["AbstractText"][:500],
"url": data.get("AbstractURL", ""),
"source": "DuckDuckGo",
"score": 90,
})
for t in data.get("RelatedTopics", [])[:8]:
if isinstance(t, dict) and "Text" in t:
out.append({
"title": strip_html(t.get("Text", ""))[:120],
"snippet": strip_html(t.get("Text", ""))[:400],
"url": t.get("FirstURL", ""),
"source": "DuckDuckGo",
"score": 60,
})
elif name == "wikipedia":
data = json.loads(body)
if "extract" in data:
out.append({
"title": data.get("title", ""),
"snippet": data.get("extract", "")[:600],
"url": data.get("content_urls", {}).get("desktop", {}).get("page", ""),
"source": "Wikipedia",
"score": 95,
})
elif name == "github":
data = json.loads(body)
for i in data.get("items", [])[:5]:
out.append({
"title": i.get("full_name", ""),
"snippet": (i.get("description") or "")[:200],
"url": i.get("html_url", ""),
"source": "GitHub",
"score": 75,
})
elif name == "hn":
data = json.loads(body)
for h in data.get("hits", [])[:5]:
out.append({
"title": h.get("title") or h.get("story_title") or "",
"snippet": "HN · {} pts".format(h.get("points", 0)),
"url": h.get("url") or ("https://news.ycombinator.com/item?id=" + str(h.get("objectID", ""))),
"source": "HackerNews",
"score": 70,
})
elif name == "stackoverflow":
data = json.loads(body)
for i in data.get("items", [])[:5]:
