self.domain_lock = threading.RLock()
self.seen_sh = {}
self.sh_lock = threading.RLock()

def can_fetch(self, url):
try:
p = urllib.parse.urlparse(url)
dom = p.netloc
with self.robots_lock:
if dom in self.robots:
rp = self.robots[dom]
else:
rp = urllib.robotparser.RobotFileParser()
rp.set_url(p.scheme + "://" + dom + "/robots.txt")
try:
rp.read()
except Exception:
rp = None
self.robots[dom] = rp
if rp is None:
return True
return rp.can_fetch(UA, url)
except Exception:
return True

def rate_limit(self, url):
try:
dom = urllib.parse.urlparse(url).netloc
with self.domain_lock:
now = time.time()
last = self.domain_last.get(dom, 0)
wait = 0.15 - (now - last)
if wait > 0:
time.sleep(min(wait, 1.0))
self.domain_last[dom] = time.time()
except Exception:
pass

def is_dup(self, sh):
with self.sh_lock:
for known_sh in self.seen_sh:
if hamming(sh, known_sh) <= 3:
return True
self.seen_sh[sh] = time.time()
if len(self.seen_sh) > 200000:
items = sorted(self.seen_sh.items(), key=lambda x: x[1])
self.seen_sh = dict(items[-150000:])
return False

def fetch(self, url, timeout=8):
self.rate_limit(url)
try:
req = urllib.request.Request(url, headers={
"User-Agent": UA,
"Accept": "text/html,application/xhtml+xml",
"Accept-Encoding": "gzip",
})
with urllib.request.urlopen(req, timeout=timeout, context=SSL_CTX) as r:
ct = r.headers.get("Content-Type", "").lower()
if "text/html" not in ct and "application/xhtml" not in ct:
return None
raw = r.read(1_500_000)
if r.headers.get("Content-Encoding", "").lower() == "gzip":
try:
raw = gzip.decompress(raw)
except Exception:
pass
return raw.decode("utf-8", "ignore")
except Exception:
return None

def index_url(self, url):
if not url or not url.startswith(("http://", "https://")):
return None
if not self.can_fetch(url):
return None

html_txt = self.fetch(url)
if not html_txt:
with self.lock:
self.stats["pages_failed"] += 1
return None

try:
parser = HTMLExtractor(base_url=url)
parser.feed(html_txt)
data = parser.result()
except Exception:
with self.lock:
self.stats["pages_failed"] += 1
return None

title = data["title"] or url
description = data["description"]
content = data["text"]
if len(content) < 200:
with self.lock:
self.stats["pages_failed"] += 1
return None

sh = simhash(title + " " + content[:3000])
if self.is_dup(sh):
with self.lock:
self.stats["pages_duplicate"] += 1
return None

domain = urllib.parse.urlparse(url).netloc
sid = IDX.add_source(url, domain, title, description, content, "CRAWL", 60)
if not sid:
return None

with self.lock:
self.stats["pages_fetched"] += 1
self.stats["pages_indexed"] += 1
self.stats["links_found"] += len(data["links"])
self.stats["last_page"] = url

for link in data["links"]:
if not link.startswith(("http://", "https://")):
continue
# Filtre extensions binaires
ext = os.path.splitext(urllib.parse.urlparse(link).path)[1].lower()
if ext in (".pdf", ".zip", ".rar", ".tar", ".gz", ".exe", ".mp4",
".mp3", ".jpg", ".jpeg", ".png", ".gif", ".webp",
".svg", ".ico", ".css", ".js", ".woff", ".woff2",
".ttf", ".eot"):
continue
link_dom = urllib.parse.urlparse(link).netloc
prio = 3 if link_dom == domain else 7
IDX.queue_add(link, priority=prio)

return {"url": url, "title": title[:80], "sid": sid}

def worker_loop(self, wid):
while self.running:
batch = IDX.queue_next(8)
if not batch:
time.sleep(0.3)
continue
for url in batch:
if not self.running:
return
try:
r = self.index_url(url)
if r:
clog("[W{}] {}".format(wid, r["url"][:100]))
except Exception as e:
clog("[W{}] err {}".format(wid, str(e)[:100]))

def start(self, num_workers=None):
if self.running:
return False
if num_workers:
self.num_workers = num_workers
self.running = True
self.stats["started_at"] = time.time()
for i in range(self.num_workers):
t = threading.Thread(target=self.worker_loop, args=(i,), daemon=True)
t.start()
self.workers.append(t)
self.stats["current_workers"] = len(self.workers)
clog("Crawler demarre : {} workers".format(self.num_workers))
return True

def stop(self):
self.running = False
clog("Crawler arrete")

def status(self):
with self.lock:
s = dict(self.stats)
elapsed = time.time() - s["started_at"] if s["started_at"] else 0
if elapsed > 0:
s["rate_per_min"] = round(s["pages_indexed"] / elapsed * 60, 1)
s["elapsed_s"] = round(elapsed, 1)
s["running"] = self.running
s["workers"] = self.num_workers
s["queue"] = IDX.queue_size()
return s


