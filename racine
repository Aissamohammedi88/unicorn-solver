class Handler(BaseHTTPRequestHandler):
server_version = "HyperionPerplexity/" + VERSION
protocol_version = "HTTP/1.1"

def log_message(self, *a):
pass

def _send(self, code, body, ctype="text/html; charset=utf-8"):
try:
if isinstance(body, str):
body = body.encode("utf-8")
self.send_response(code)
self.send_header("Content-Type", ctype)
self.send_header("Content-Length", str(len(body)))
self.send_header("Access-Control-Allow-Origin", "*")
self.end_headers()
self.wfile.write(body)
except (BrokenPipeError, ConnectionResetError):
pass

def _json(self, code, obj):
self._send(code, json.dumps(obj, ensure_ascii=False, default=str),
"application/json; charset=utf-8")

def do_GET(self):
p = urllib.parse.urlparse(self.path)
path = p.path
qs = urllib.parse.parse_qs(p.query)

if path in ("/", "/index.html"):
return self._send(200, page_html())

if path == "/api/search":
q = (qs.get("q", [""])[0] or "").strip()
if not q:
return self._json(400, {"error": "missing q"})
try:
return self._json(200, search(q))
except Exception as e:
return self._json(500, {"error": str(e)[:200]})

if path == "/api/stats":
return self._json(200, {
"index": IDX.stats(),
"crawler": CRAWLER.status(),
"cache": len(CACHE),
"version": VERSION,
"seeds": len(SEED_DOMAINS),
"apis": len(TRANSIT_APIS),
})

if path == "/api/crawler/status":
return self._json(200, CRAWLER.status())

if path == "/api/sources":
return self._json(200, {
"seeds": SEED_DOMAINS,
"apis": list(TRANSIT_APIS.keys()),
"count_seeds": len(SEED_DOMAINS),
"count_apis": len(TRANSIT_APIS),
})

if path == "/api/health":
return self._json(200, {
"engine": "HYPERION PERPLEXITY",
"version": VERSION,
"auteur": AUTEUR,
"licence": LICENCE,
"repo": GIT["repo"],
"seeds_count": len(SEED_DOMAINS),
"apis_count": len(TRANSIT_APIS),
"index": IDX.stats(),
})

if path == "/api/recent":
limit = int(qs.get("limit", ["20"])[0])
return self._json(200, {"docs": IDX.recent(limit)})

if path == "/metrics":
st = IDX.stats()
cr = CRAWLER.status()
lines = [
"# HELP hyperion_sources Total indexed sources",
"# TYPE hyperion_sources gauge",
"hyperion_sources " + str(st.get("sources", 0)),
"# HELP hyperion_terms Total indexed terms",
"# TYPE hyperion_terms gauge",
"hyperion_terms " + str(st.get("terms", 0)),
"# HELP hyperion_queue Queue size",
"# TYPE hyperion_queue gauge",
"hyperion_queue " + str(st.get("queue", 0)),
"# HELP hyperion_crawl_indexed_total Pages indexed",
"# TYPE hyperion_crawl_indexed_total counter",
"hyperion_crawl_indexed_total " + str(cr.get("pages_indexed", 0)),
"# HELP hyperion_crawl_failed_total Pages failed",
"# TYPE hyperion_crawl_failed_total counter",
"hyperion_crawl_failed_total " + str(cr.get("pages_failed", 0)),
"# HELP hyperion_crawl_dup_total Duplicates avoided",
"# TYPE hyperion_crawl_dup_total counter",
"hyperion_crawl_dup_total " + str(cr.get("pages_duplicate", 0)),
"# HELP hyperion_rate_pages_per_min Crawl rate",
"# TYPE hyperion_rate_pages_per_min gauge",
"hyperion_rate_pages_per_min " + str(cr.get("rate_per_min", 0)),
"# HELP hyperion_workers Active crawl workers",
"# TYPE hyperion_workers gauge",
"hyperion_workers " + str(cr.get("workers", 0)),
]
return self._send(200, "\n".join(lines) + "\n", "text/plain; charset=utf-8")

return self._json(404, {"error": "not found"})

def do_POST(self):
p = urllib.parse.urlparse(self.path)
path = p.path

if path == "/api/crawler/start":
ok = CRAWLER.start()
return self._json(200, {"started": ok, "workers": CRAWLER.num_workers})

if path == "/api/crawler/stop":
CRAWLER.stop()
return self._json(200, {"stopped": True})

if path == "/api/seed/all":
n = seed_all()
return self._json(200, {"added": n, "total_domains": len(SEED_DOMAINS)})

if path == "/api/seed/wikipedia":
n = seed_wikipedia_random(1000)
return self._json(200, {"added": n})

return self._json(404, {"error": "not found"})


class Server(ThreadingHTTPServer):
daemon_threads = True
allow_reuse_address = True


