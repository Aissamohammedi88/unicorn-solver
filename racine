def tokenize(text):
if not text:
return []
words = _word_rx.findall(text.lower())
return [w.strip("'-") for w in words if w not in STOPWORDS]


def strip_html(s):
if not s:
return ""
s = re.sub(r"<[^>]+>", " ", s)
s = html.unescape(s)
s = re.sub(r"\s+", " ", s)
return s.strip()


def simhash(text, bits=64):
if not text:
return 0
tokens = tokenize(text)
if not tokens:
return 0
v = [0] * bits
for tok in tokens:
h = int(hashlib.md5(tok.encode("utf-8", "ignore")).hexdigest()[:16], 16)
for i in range(bits):
v[i] += 1 if (h & (1 << i)) else -1
out = 0
for i in range(bits):
if v[i] > 0:
out |= (1 << i)
return out


def hamming(a, b):
return bin(a ^ b).count("1")


def http_get(url, timeout=10, headers=None, max_size=3_000_000):
h = {"User-Agent": UA, "Accept": "*/*", "Accept-Encoding": "gzip"}
if headers:
h.update(headers)
try:
req = urllib.request.Request(url, headers=h)
t0 = time.time()
with urllib.request.urlopen(req, timeout=timeout, context=SSL_CTX) as r:
raw = r.read(max_size)
if r.headers.get("Content-Encoding", "").lower() == "gzip":
try:
raw = gzip.decompress(raw)
except Exception:
pass
return {
"ok": True,
"body": raw.decode("utf-8", "ignore"),
"status": r.status,
"ms": round((time.time() - t0) * 1000),
}
except urllib.error.HTTPError as e:
return {"ok": False, "err": "HTTP " + str(e.code), "status": e.code}
except Exception as e:
return {"ok": False, "err": str(e)[:120], "status": 0}


