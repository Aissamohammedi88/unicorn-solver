def log(msg, to_file=None):
ts = time.strftime("%Y-%m-%d %H:%M:%S")
try:
safe = str(msg).encode("ascii", "ignore").decode("ascii")
except Exception:
safe = str(msg)
line = "[{}] {}".format(ts, safe)
try:
print(line, flush=True)
except Exception:
pass
target = to_file or LOG_FILE
with LOG_LOCK:
try:
with open(target, "a", encoding="utf-8") as f:
f.write(line + "\n")
except OSError:
pass


