# SECTION 5 · SOLVER 3 : SKETCH HYPERLOGLOG (cardinalite approximative)
# ═══════════════════════════════════════════════════════════════════════════

class HyperLogLog:
"""Estimation de cardinalite en O(1) memoire, erreur < 2%.
Pour 100M users, HLL tient en 12 KB.
"""

def __init__(self, b=14):
self.b = b
self.m = 1 << b
self.registers = [0] * self.m

def add(self, x):
h = int(hashlib.md5(str(x).encode()).hexdigest()[:16], 16)
idx = h & (self.m - 1)
w = h >> self.b
rank = 1
while w and not (w & 1):
rank += 1
w >>= 1
if rank > self.registers[idx]:
self.registers[idx] = rank

def count(self):
alpha = 0.7213 / (1 + 1.079 / self.m)
Z = sum(2.0 ** (-r) for r in self.registers)
E = alpha * self.m * self.m / Z
if E <= 2.5 * self.m:
V = self.registers.count(0)
if V > 0:
E = self.m * math.log(self.m / V)
return int(E)


def build_hll(graphe):
"""Construit un HLL par resto."""
t0 = time.time()
hlls = {}
for resto_id, users in graphe["resto_to_users"].items():
h = HyperLogLog()
for u in users:
h.add(u)
hlls[resto_id] = h
return hlls, round((time.time() - t0) * 1000, 2)


def solve_hll(graphe, hlls, min_likes=1):
t0 = time.time()
restos_jp_ny = graphe["restos_ny_jp"]
resultats = []
for resto_id in restos_jp_ny:
h = hlls.get(resto_id)
if not h:
continue
n = h.count()
if n >= min_likes:
resultats.append({
"resto_id": resto_id,
"nb_users_jp": n,
})
resultats.sort(key=lambda x: -x["nb_users_jp"])
mem = len(hlls) * (1 << 14)
return {
"solution": "hyperloglog",
"resultats": resultats,
"temps_ms": round((time.time() - t0) * 1000, 2),
"memoire_ko": round(mem / 1024, 1),
"nb_hll": len(hlls),
}


