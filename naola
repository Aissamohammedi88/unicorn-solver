# SECTION 2 · GENERATION DU GRAPHE SYNTHETIQUE
# ═══════════════════════════════════════════════════════════════════════════

def generer_graphe(scale=1):
"""Genere un graphe synthetique realiste.
scale=1 : miniature testable (100K users, 5K restos)
scale=1000 : version reelle (100M users, 50K restos)
"""
n_users_jp = 100_000 * scale
n_resto_ny = 50_000
n_resto_ny_jp = int(5_000 * (1 if scale == 1 else math.log10(scale) + 1))
n_likes_par_user = 200

random.seed(42)

# Utilisateurs japonais
users_jp = [i for i in range(n_users_jp)]

# Restaurants NY
restos_ny = [i for i in range(n_resto_ny)]
restos_ny_jp = random.sample(restos_ny, min(n_resto_ny_jp, n_resto_ny))

# Index inversé : restaurant -> set de users JP qui l'ont like
# C'est LA structure qui rend le probleme soluble en RAM.
# Chaque restaurant est like par ~500 users JP en moyenne
resto_to_users = defaultdict(set)

# Simuler les likes
for user_id in users_jp:
# Chaque user JP aime ~200 restos (parmi NY et ailleurs)
n_likes = n_likes_par_user
# 30% de ses likes vont sur des restos NY
n_ny = int(n_likes * 0.3)
liked = random.sample(restos_ny, min(n_ny, len(restos_ny)))
for r in liked:
resto_to_users[r].add(user_id)

return {
"n_users_jp": n_users_jp,
"n_resto_ny": n_resto_ny,
"restos_ny_jp": set(restos_ny_jp),
"resto_to_users": dict(resto_to_users),
}


# ═══════════════════════════════════════════════════════════════════════════
# SECTION 3 · SOLVER 1 : INVERSE INDEX PUR
# ═══════════════════════════════════════════════════════════════════════════

def solve_inverse_index(graphe, min_likes=1):
"""Solution 1 : pour chaque resto JP a NY, compter les users JP.

Complexite : O(R * avg_likes_per_rest) avec R = restos NY JP
Pas de force brute sur les 20 milliards de likes.
"""
t0 = time.time()
restos_jp_ny = graphe["restos_ny_jp"]
resto_to_users = graphe["resto_to_users"]

resultats = []
for resto_id in restos_jp_ny:
users = resto_to_users.get(resto_id, set())
if len(users) >= min_likes:
resultats.append({
"resto_id": resto_id,
"nb_users_jp": len(users),
})

resultats.sort(key=lambda x: -x["nb_users_jp"])
return {
"solution": "inverse_index",
"resultats": resultats,
"temps_ms": round((time.time() - t0) * 1000, 2),
"operations": sum(len(resto_to_users.get(r, set()))
for r in restos_jp_ny),
}


