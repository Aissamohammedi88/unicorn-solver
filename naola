# SECTION 4 · SOLVER 2 : BITMAP COMPRESS (Roaring-like)
# ═══════════════════════════════════════════════════════════════════════════

class CompressedBitmap:
"""Bitmap compresse avec run-length encoding pour stocker de grands
ensembles d'IDs en RAM reduite.

Pour 100M users, un bitmap naif = 12.5 MB par resto.
Avec RLE + chunks : ~500 KB en moyenne par resto.
"""

def __init__(self):
self.chunks = {} # chunk_id (user_id // 65536) -> list of (start, end)

def add(self, user_id):
chunk_id = user_id >> 16
offset = user_id & 0xFFFF
if chunk_id not in self.chunks:
self.chunks[chunk_id] = []
self.chunks[chunk_id].append(offset)

def finalize(self):
"""Compresse chaque chunk en runs."""
for cid in self.chunks:
offsets = sorted(set(self.chunks[cid]))
runs = []
if not offsets:
continue
start = offsets[0]
prev = offsets[0]
for o in offsets[1:]:
if o == prev + 1:
prev = o
else:
runs.append((start, prev))
start = o
prev = o
runs.append((start, prev))
self.chunks[cid] = runs

def count(self):
n = 0
for runs in self.chunks.values():
for s, e in runs:
n += e - s + 1
return n

def intersection_size(self, other):
n = 0
for cid in self.chunks:
if cid not in other.chunks:
continue
a = self.chunks[cid]
b = other.chunks[cid]
n += self._runs_intersection(a, b)
return n

def _runs_intersection(self, a, b):
n = 0
i = j = 0
while i < len(a) and j < len(b):
s1, e1 = a[i]
s2, e2 = b[j]
s = max(s1, s2)
e = min(e1, e2)
if s <= e:
n += e - s + 1
if e1 < e2:
i += 1
else:
j += 1
return n

def size_bytes(self):
n = 0
for runs in self.chunks.values():
for s, e in runs:
n += 8 # deux entiers de 4 bytes
n += 8 # overhead chunk
return n


def build_bitmaps(graphe):
"""Construit les bitmaps compresses pour chaque resto."""
t0 = time.time()
bitmaps = {}
for resto_id, users in graphe["resto_to_users"].items():
bm = CompressedBitmap()
for u in users:
bm.add(u)
bm.finalize()
bitmaps[resto_id] = bm
return bitmaps, round((time.time() - t0) * 1000, 2)


def solve_bitmap(graphe, bitmaps, min_likes=1):
"""Solution 2 : bitmap compresse + run-length."""
t0 = time.time()
restos_jp_ny = graphe["restos_ny_jp"]

resultats = []
for resto_id in restos_jp_ny:
bm = bitmaps.get(resto_id)
if not bm:
continue
n = bm.count()
if n >= min_likes:
resultats.append({
"resto_id": resto_id,
"nb_users_jp": n,
})

resultats.sort(key=lambda x: -x["nb_users_jp"])
mem = sum(bm.size_bytes() for bm in bitmaps.values())
return {
"solution": "bitmap_rle",
"resultats": resultats,
"temps_ms": round((time.time() - t0) * 1000, 2),
"memoire_ko": round(mem / 1024, 1),
"nb_bitmaps": len(bitmaps),
}


