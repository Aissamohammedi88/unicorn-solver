def generate_answer(query, sources):
"""Génère une réponse type Perplexity : synthèse + citations."""
if not sources:
return {"answer": "Aucune source trouvée pour cette requête.",
"citations": []}

# Extraction des phrases clés des top sources
sentences = []
for i, src in enumerate(sources[:10], 1):
snippet = src.get("snippet") or ""
if len(snippet) < 50:
continue
# Nettoyage
snippet = re.sub(r"\s+", " ", snippet).strip()
sentences.append({
"text": snippet[:400],
"source_id": i,
"url": src.get("url", ""),
"title": src.get("title", ""),
"domain": src.get("domain", ""),
})

# Construction de la réponse
answer_parts = []
answer_parts.append("Voici une synthèse basée sur " + str(len(sentences)) + " sources :\n")

for i, s in enumerate(sentences[:8], 1):
answer_parts.append("{}. {} [{}]".format(i, s["text"], s["source_id"]))

answer_text = "\n".join(answer_parts)

citations = [
{
"id": s["source_id"],
"url": s["url"],
"title": s["title"],
"domain": s["domain"],
}
for s in sentences
]

return {
"answer": answer_text,
"citations": citations,
"nb_sources": len(sentences),
}


