<script>
document.getElementById('q').addEventListener('keydown', e => {
if (e.key === 'Enter') doSearch();
});

async function doSearch() {
const q = document.getElementById('q').value.trim();
if (!q) return;
document.getElementById('answer-container').innerHTML = '<div class="empty">Recherche...</div>';
document.getElementById('results').innerHTML = '';
try {
const r = await fetch('/api/search?q=' + encodeURIComponent(q));
const d = await r.json();
document.getElementById('stats').innerHTML =
'<b>' + d.count + '</b> sources · ' +
d.sources.length + ' APIs · ' +
'<b>' + d.duration_ms + 'ms</b>';
renderAnswer(d);
renderResults(d);
} catch(e) {
document.getElementById('answer-container').innerHTML = '<div class="empty">Erreur : ' + e.message + '</div>';
}
}

function renderAnswer(d) {
if (!d.answer || !d.answer.answer) return;
const a = d.answer;
let html = '<div class="answer">';
html += '<h2>Réponse synthétisée · ' + (a.nb_sources || 0) + ' sources</h2>';
html += '<p>' + escapeHtml(a.answer).replace(/\[(\d+)\]/g, '<sup>[$1]</sup>') + '</p>';
if (a.citations && a.citations.length) {
html += '<div class="citations"><h3>Citations</h3>';
a.citations.forEach(c => {
html += '<a class="citation" href="' + escapeAttr(c.url) + '" target="_blank">' +
'<b>[' + c.id + ']</b>' + escapeHtml(c.title || c.url) +
' · ' + escapeHtml(c.domain) + '</a>';
});
html += '</div>';
}
html += '</div>';
document.getElementById('answer-container').innerHTML = html;
}

function renderResults(d) {
if (!d.results || d.results.length === 0) return;
document.getElementById('results').innerHTML = d.results.map(r => `
<a class="result" href="${escapeAttr(r.url)}" target="_blank" rel="noopener">
<div class="score">${r.score_final}</div>
<span class="src">${escapeHtml(r.source)}</span>
<h3>${escapeHtml(r.title)}</h3>
<p>${escapeHtml(r.snippet)}</p>
<div class="url">${escapeHtml(r.url)}</div>
</a>
`).join('');
}

function escapeHtml(t) { const d = document.createElement('div'); d.textContent = t == null ? '' : String(t); return d.innerHTML; }
function escapeAttr(t) { return escapeHtml(t).replace(/"/g, '&quot;'); }

async function post(p) { const r = await fetch(p, {method:'POST'}); return await r.json(); }
async function get(p) { const r = await fetch(p); return await r.json(); }

async function crawlStart() { document.getElementById('ix-out').textContent = JSON.stringify(await post('/api/crawler/start'), null, 2); }
async function crawlStop() { document.getElementById('ix-out').textContent = JSON.stringify(await post('/api/crawler/stop'), null, 2); }
async function seedAll() { document.getElementById('ix-out').textContent = JSON.stringify(await post('/api/seed/all'), null, 2); }
async function seedWiki() { document.getElementById('ix-out').textContent = JSON.stringify(await post('/api/seed/wikipedia'), null, 2); }
async function crawlStatus() { document.getElementById('ix-out').textContent = JSON.stringify(await get('/api/crawler/status'), null, 2); }

async function refreshStats() {
try {
const d = await get('/api/stats');
document.getElementById('st-sources').textContent = d.index.sources || 0;
document.getElementById('st-terms').textContent = d.index.terms || 0;
document.getElementById('st-queue').textContent = d.index.queue || 0;
document.getElementById('st-rate').textContent = (d.crawler && d.crawler.rate_per_min) || 0;
document.getElementById('st-workers').textContent = (d.crawler && d.crawler.workers) || 0;
document.getElementById('st-dup').textContent = (d.crawler && d.crawler.pages_duplicate) || 0;
} catch(e) {}
}

setTimeout(() => document.getElementById('q').focus(), 100);
refreshStats();
setInterval(refreshStats, 3000);
</script>
</body>
</html>
"""


def page_html():
h = HTML
h = h.replace("__V__", VERSION)
return h


