# SECTION 7 · SOLVER 5 : COMBINAISON ULTIME (bitmap + HLL + lattice)
# ═══════════════════════════════════════════════════════════════════════════

def solve_hybrid(graphe, bitmaps, hlls, seuil=100):
"""Solution finale : combine les 3 approches.
1. HLL pour un premier filtre rapide (cardinalite approximative)
2. Bitmap pour les restos qui passent le seuil
3. Lattice pour le tri final
"""
t0 = time.time()
restos_jp_ny = graphe["restos_ny_jp"]

# Etape 1 : filtre HLL rapide
candidats = []
for resto_id in restos_jp_ny:
h = hlls.get(resto_id)
if not h:
continue
if h.count() >= seuil:
candidats.append(resto_id)

# Etape 2 : verification precise par bitmap
resultats = []
for resto_id in candidats:
bm = bitmaps.get(resto_id)
if not bm:
continue
n = bm.count()
resultats.append({
"resto_id": resto_id,
"nb_users_jp": n,
"approx_hll": hlls[resto_id].count(),
})

# Etape 3 : tri final
resultats.sort(key=lambda x: -x["nb_users_jp"])

return {
"solution": "hybrid_hll_bitmap_lattice",
"resultats": resultats,
"temps_ms": round((time.time() - t0) * 1000, 2),
"candidats_hll": len(candidats),
"verifies_bitmap": len(resultats),
}


