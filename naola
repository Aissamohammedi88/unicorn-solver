# SECTION 6 · SOLVER 4 : INDEX DE SUBSET + LATTICE
# ═══════════════════════════════════════════════════════════════════════════

def solve_lattice(graphe, seuil_users=500):
"""Solution 4 : construit un lattice (treillis) des restos par nombre
d'users JP. Seuls les restos avec > seuil sont conserves.

Complexite : O(R * log(R)) apres tri.
"""
t0 = time.time()
restos_jp_ny = graphe["restos_ny_jp"]
resto_to_users = graphe["resto_to_users"]

# Filtrer : on ne garde que les restos avec beaucoup de users JP
freq = Counter()
for resto_id in restos_jp_ny:
users = resto_to_users.get(resto_id, set())
freq[resto_id] = len(users)

# Lattice par buckets de popularite
buckets = defaultdict(list)
for resto_id, n in freq.items():
if n >= seuil_users:
b = int(math.log10(n + 1))
buckets[b].append((resto_id, n))

resultats = []
for b in sorted(buckets.keys(), reverse=True):
items = sorted(buckets[b], key=lambda x: -x[1])
for resto_id, n in items:
resultats.append({
"resto_id": resto_id,
"nb_users_jp": n,
})

return {
"solution": "lattice",
"resultats": resultats,
"temps_ms": round((time.time() - t0) * 1000, 2),
"seuil": seuil_users,
}


